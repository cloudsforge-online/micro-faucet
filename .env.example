# micro-faucet — the testnet EMBER faucet.
#
# Copy to .env, which is gitignored and is listed in .dockerignore. Every value below is a
# PLACEHOLDER; there is no working secret in this file and there must never be one.
#
# ─────────────────────────────────────────────────────────────────────────────────────────────
# THERE IS NO CHAIN ID VARIABLE, AND THERE IS NO KEY VARIABLE. Both absences are deliberate.
#
#   The chain id is read from @cloudsforge/contracts-chain, which pins EMBER at
#   { mainnet: 7411, testnet: 7412 }. This service dispenses on 7412 and there is no value of any
#   variable that changes that. FAUCET_CHAIN_ID below exists only so that a deploy which sets it
#   out of habit gets a refusal rather than a surprise.
#
#   The key is micro-custody's. This process never holds one. See README.md and src/custodyclient.ts.
# ─────────────────────────────────────────────────────────────────────────────────────────────

# --- the service -----------------------------------------------------------------------------
PORT=4013
NODE_ENV=production
LOG_LEVEL=info

# One database, named by this service's own variable — rule 1. CI greps for any second
# connection-string variable, so adding one fails the build rather than review.
FAUCET_DATABASE_URL=postgres://faucet:CHANGE_ME@postgres:5432/faucet
FAUCET_DATABASE_POOL_MAX=10

IDENTITY_JWKS_URL=http://identity:4001/.well-known/jwks.json
IDENTITY_ISSUER=http://identity:4001

# Gates /metrics. Refused at boot if it is a known placeholder or shorter than 24 characters:
# `openssl rand -hex 24`.
FAUCET_TOKEN=CHANGE_ME_generate_with_openssl_rand_hex_24

# --- the chain -------------------------------------------------------------------------------
# The Hearth testnet eth_* endpoint. NOT the UTXO-era REST API, which lives on a neighbouring port
# and answers any POST it does not recognise with {"err":…} at HTTP 200 — the single most common
# misconfiguration, and one src/rpc.ts names explicitly when it happens.
FAUCET_RPC_URL=http://hearth-testnet:8545
FAUCET_RPC_DEADLINE_MS=10000

# Optional, and it may only AGREE. Set it to anything else — 7411 above all, which is EMBER
# MAINNET — and the service exits at boot with a message saying so.
#FAUCET_CHAIN_ID=7412

# Legacy (type 0) gas price in wei. Ember v1 has no EIP-1559 fee market and its node has no type-2
# decoder, so this is the only fee model there is. 1 gwei.
FAUCET_GAS_PRICE_WEI=1000000000

# --- custody, which holds the key --------------------------------------------------------------
CUSTODY_URL=http://custody:4005
CUSTODY_DEADLINE_MS=10000

# A service token carrying `custody:sign:treasury` and nothing else. Not `custody:sign:deposit`:
# this service does not sweep, and a deployment that does not sweep should not be issued it.
CUSTODY_TOKEN=CHANGE_ME_a_custody_service_token

# The faucet's OWN address — public on chain the moment the first drip lands, and never a key.
#
# Mint it once, as an operator, with a token carrying the address-create scope:
#
#   curl -sX POST "$CUSTODY_URL/v1/addresses" -H "authorization: Bearer $OPERATOR_TOKEN" \
#        -H 'content-type: application/json' \
#        -d '{"chain":"ember","network":"testnet","purpose":"treasury",
#             "userId":"cloudsforge:faucet","orderId":"faucet:ember:testnet"}'
#
# `purpose: treasury` is what selects the signing POLICY — a plain value transfer with empty
# calldata, and nothing else. It is a treasury-purpose address; it is NOT the platform treasury,
# and it must not be, or this service and micro-settlement would share a nonce.
FAUCET_FUNDING_ADDRESS=0xCHANGE_ME_the_address_custody_minted_here

# The other two thirds of custody's binding. It compares seven identity fields character for
# character and its 403 deliberately does not say which one disagreed, so these cannot be debugged
# from a response — they must match the mint request above exactly.
FAUCET_CUSTODY_USER_ID=cloudsforge:faucet
FAUCET_CUSTODY_ORDER_ID=faucet:ember:testnet

# --- what it pays out ---------------------------------------------------------------------------
# Whole EMBER, parsed to wei without floating point. The drip is FIXED and is never read from a
# request: every faucet that has ever been drained let the caller influence the amount.
FAUCET_DRIP_EMBER=10

# One drip per address per this many seconds. The only limit an honest user ever meets.
FAUCET_ADDRESS_COOLDOWN_SECONDS=86400

# Per requester — the client address, first hop of x-forwarded-for. Weak on its own and known to
# be: an IPv6 /64 has 2^64 addresses. It stops the lazy case at the cost of one row.
FAUCET_REQUESTER_LIMIT=3
FAUCET_REQUESTER_WINDOW_SECONDS=86400

# THE CONTROL THAT BOUNDS THE LOSS. However many addresses and however many requesters, the faucet
# pays out at most this per rolling window and then refuses everyone. Set it to what you are
# willing to lose in a day. Enforced by a CHECK, not only by application code.
FAUCET_BUDGET_EMBER=1000
FAUCET_BUDGET_WINDOW_SECONDS=86400

# Refuse an address that already holds this much — a faucet exists to unblock someone with nothing.
# 0 disables the rule. A non-zero value below one drip is refused at boot, because it would bar
# every address the faucet had already funded.
FAUCET_MAX_RECIPIENT_EMBER=100

# Hold the queue at this balance rather than broadcasting transactions the node will reject for
# insufficient funds.
FAUCET_RESERVE_EMBER=1

# --- housekeeping --------------------------------------------------------------------------------
# Settled dispenses are pruned after this many days. A LIVE row is never pruned however old it is:
# a dispense stuck in `broadcast` is a signed transaction whose fate nobody knows.
FAUCET_RETENTION_DAYS=30

# Browser origins allowed to POST a drip. An allowlist, never a wildcard; empty means no browser
# may post, which is the default.
## network.<apex>, because that is where the faucet page LIVES: the registry gives faucet
# `subdomain: 'network'` with `basePath: '/faucet'` - it is a route on Forge Network's host, not a
# host of its own. This used to suggest https://faucet.cloudsforge.online, a hostname the registry
# has never defined, which is the devportal-vs-developers defect again: an allowlist naming a host
# nobody serves fails closed and silently.
FAUCET_CORS_ORIGINS=https://network.cloudsforge.online

# Set by the deploy, not by hand.
#CLOUDSFORGE_TAG=
#INSTANCE_ID=
